     def run_busy_loop(self):
         """Core busy loop of the EngineCore."""
+        # --- TEMP INSTRUMENTATION (VLLM_ITER_STAGE_PROFILE=1) -----------------
+        # Attributes the ~20s stall, which `iteration elapsed time` does not
+        # cover. `input` is the input-queue drain; `sched` / `submit` / `wait` /
+        # `update` are filled in by step_with_batch_queue (the path used when
+        # async scheduling is on). On a slow loop the per-phase DELTA for that
+        # single iteration is printed, which names the guilty call directly.
+        # Remove together with the matching block in step / step_with_batch_queue.
+        _prof = os.environ.get("VLLM_ITER_STAGE_PROFILE") == "1"
+        _slow = float(os.environ.get("VLLM_ITER_STAGE_SLOW", "0.5"))
+        _KEYS = ("input", "sched", "submit", "wait", "update")
+        if _prof:
+            self._prof_acc = dict.fromkeys(_KEYS, 0.0)
+            self._prof_acc["iters"] = 0
+            self._prof_last = time.monotonic()
         while self._handle_shutdown():
             # 1) Poll the input queue until there is work to do.
+            _t0 = time.monotonic() if _prof else 0.0
+            _snap = dict(self._prof_acc) if _prof else None
             self._process_input_queue()
             # 2) Step the engine core and return the outputs.
+            _t1 = time.monotonic() if _prof else 0.0
             self._process_engine_step()
+            if _prof:
+                _t2 = time.monotonic()
+                a = self._prof_acc
+                a["input"] += _t1 - _t0
+                a["iters"] += 1
+                if _t2 - _t0 > _slow:
+                    parts = " ".join(
+                        f"{k}={a[k] - _snap[k]:.3f}s" for k in _KEYS if a[k] - _snap[k] > 1e-3
+                    )
+                    logger.warning(
+                        "[stage-prof] slow loop %.3fs (input %.3fs) | this iter: %s",
+                        _t2 - _t0, _t1 - _t0, parts or "(all zero)",
+                    )
+                if _t2 - self._prof_last > 20.0:
+                    n = max(a["iters"], 1)
+                    logger.info(
+                        "[stage-prof] win %.1fs n=%d | %s | sum %.3fs",
+                        _t2 - self._prof_last, n,
+                        " ".join(f"{k}={a[k]:.3f}s({a[k] / n * 1000:.2f}ms/it)" for k in _KEYS),
+                        sum(a[k] for k in _KEYS),
+                    )
+                    self._prof_acc = dict.fromkeys(_KEYS, 0.0)
+                    self._prof_acc["iters"] = 0
+                    self._prof_last = _t2
+        # --- END TEMP INSTRUMENTATION ---------------------------------------
 
         raise SystemExit
 
