     def run_busy_loop(self):
         """Core busy loop of the EngineCore."""
+        # --- TEMP INSTRUMENTATION (VLLM_ITER_STAGE_PROFILE=1) -----------------
+        # Attributes the ~20s stall, which `iteration elapsed time` does not
+        # cover. `input` is the input-queue drain; `sched` / `submit` / `wait` /
+        # `update` are filled in by step_with_batch_queue (the path used when
+        # async scheduling is on). On a slow loop the per-phase DELTA for that
+        # single iteration is printed, which names the guilty call directly.
+        # Remove together with the matching block in step / step_with_batch_queue.
+        _prof = os.environ.get("VLLM_ITER_STAGE_PROFILE") == "1"
+        _slow = float(os.environ.get("VLLM_ITER_STAGE_SLOW", "0.5"))
+        # Detailed phases. `submit` is NOT stored: it is derived at print time as
+        # exec+gram+sample, so the closure check cannot double count it.
+        _KEYS = ("input", "sched", "exec", "gram", "sample", "wait", "update")
+        _SUB = ("exec", "gram", "sample")
+        # step_total is timed here in run_busy_loop, not inside the step fn, so
+        # that `unmarked = step_total - (all step phases)` exposes the part of a
+        # step that the phase marks do not cover. Without it the marks can
+        # silently account for only a fraction of the wall time and still look
+        # plausible. NOTE: `input` is deliberately excluded from the closure
+        # check -- it is drained before step_total starts, so including it makes
+        # `unmarked` negative by exactly the idle time.
+        _STEP_KEYS = ("sched", "exec", "gram", "sample", "wait", "update")
+        _EXTRA = ("step_total",)
