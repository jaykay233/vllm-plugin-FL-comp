 logger = init_logger(__name__)
 
+# ---------------------------------------------------------------------------
+# [stage-prof] EngineCore busy-loop stage instrumentation.
+#
+# Enable with VLLM_ITER_STAGE_PROFILE=1.
+#   VLLM_ITER_STAGE_WINDOW  window length in seconds (default 10)
+#   VLLM_ITER_STAGE_SLOW    slow single-iteration threshold in seconds (default 0.5)
+#
+# Emitted on stdout (deliberately NOT via logger: a previous revision logged a
+# lazy "%"-format string and the multiprocessing log collector preserved the
+# format string instead of interpolating it, so no window ever carried numbers).
+# Parsed by experiments/src/stage_prof_scan.py:
+#
+#   [stage-prof] win <win>s n=<n> | input <s> (<ms>/it) loop_step <s> (<ms>/it)
+#                || in step: sched <s> (<ms>) exe <s> (<ms>) upd <s> (<ms>)
+#                || detail: gram <s> (<ms>) sample <s> (<ms>) wait <s> (<ms>)
+#                           resid <s> (<ms>) idle <s> (<ms>) unmarked <s>
+#
+# WHERE THE TIME IS ACCOUNTED FOR
+#   input     whole _process_input_queue() poll, including the blocking wait
+#   sched     scheduler.schedule()
+#   exec      model_executor.execute_model() submit (non-blocking)
+#   gram      scheduler.get_grammar_bitmask()
+#   sample    model_executor.sample_tokens() submit (non-blocking)
+#   wait      future.result() inside the log_iteration_details block -- this is
+#             the GPU-bound part and MUST be timed inside that `with` block
+#   upd       _process_aborts_queue() + scheduler.update_from_output()
+#   resid     loop_step minus the six stages above == step_fn() bookkeeping +
+#             output enqueue + post_step()
+#   idle      subset of `input` that was blocked in input_queue.get()
+#
+# `exe` in the scanner line is the old aggregate exec+gram+sample+wait, kept so
+# that the original scan math (loop_step - sched - exe - upd == resid) holds.
+#
+# CLOSURE CONTRACT (check every window): `unmarked` = win - input - loop_step
+# must be ~0, otherwise the attribution is not trustworthy.
+#
+# NOTE: instrument step_with_batch_queue(), NOT step(). Under async scheduling
+# the engine takes the batch-queue path; step() is a dead path there and its
+# counters would stay 0 forever.
+# ---------------------------------------------------------------------------
+_STAGE_PROFILE_ENABLED = os.environ.get("VLLM_ITER_STAGE_PROFILE", "0") == "1"
+_STAGE_STAGE_KEYS = ("sched", "exec", "gram", "sample", "wait", "upd")
+# Sink for the probe lines. NOT stdout: vLLM wraps EngineCore stdout
+# (utils/system_utils.py::decorate_logs) and dup2()s it to /dev/null in places,
+# which is why two earlier revisions of this instrumentation produced no usable
+# output (one lost the numbers to a lazy %-format string in the mp log
+# collector, the other produced nothing at all). A plain append-mode file
+# descriptor that we open ourselves is immune to all of that.
+_STAGE_PROFILE_FILE = os.environ.get("VLLM_ITER_STAGE_FILE", "")
+
+
+def _stage_emit(line: str) -> None:
+    """Emit one probe line, never raising into the engine's hot path."""
+    stamp = time.strftime("%H:%M:%S")
+    text = f"[stage-prof] {stamp} pid={os.getpid()} {line}\n"
+    if _STAGE_PROFILE_FILE:
+        try:
+            fd = os.open(
+                _STAGE_PROFILE_FILE,
+                os.O_WRONLY | os.O_CREAT | os.O_APPEND,
+                0o644,
+            )
+            try:
+                os.write(fd, text.encode())
+            finally:
+                os.close(fd)
+        except OSError:
+            pass
+    else:
+        try:
+            print(text, end="", flush=True)
+        except Exception:
+            pass
+
+
+class _StageProf:
+    """Accumulate EngineCore busy-loop stage timings and print windows."""
+
+    def __init__(self, window_sec: float, slow_sec: float):
+        self.window_sec = window_sec
+        self.slow_sec = slow_sec
+        self.win_start: float | None = None
+        self.last_flush: float | None = None
+        self.n = 0
+        self.all_keys = (*_STAGE_STAGE_KEYS, "input", "loop_step", "idle", "resid")
+        self.acc: dict[str, float] = dict.fromkeys(self.all_keys, 0.0)
+        self.it: dict[str, float] = dict.fromkeys(self.all_keys, 0.0)
+        self.iter_input = 0.0
+
+    # -- accumulation ------------------------------------------------------
+    def add(self, key: str, dt: float) -> None:
+        self.acc[key] += dt
+        self.it[key] += dt
+
+    def begin(self, now: float) -> None:
+        if self.win_start is None:
+            self.win_start = now
+            self.last_flush = now
+
+    def inner(self) -> float:
+        """Sum of the six stages measured inside step_with_batch_queue()."""
+        a = self.acc
+        return sum(a[k] for k in _STAGE_STAGE_KEYS)
+
+    # -- per-iteration -----------------------------------------------------
+    def end_iteration(self) -> None:
+        total = self.it["input"] + self.it["loop_step"]
+        if self.slow_sec > 0 and total >= self.slow_sec:
+            _stage_emit(
+                "slow loop %.3fs | step_total=%.3fs | this iter: "
+                "input=%.3fs sched=%.3fs exec=%.3fs gram=%.3fs sample=%.3fs "
+                "wait=%.3fs update=%.3fs resid=%.3fs"
+                % (
+                    total,
+                    self.it["loop_step"],
+                    self.it["input"],
+                    self.it["sched"],
+                    self.it["exec"],
+                    self.it["gram"],
+                    self.it["sample"],
+                    self.it["wait"],
+                    self.it["upd"],
+                    self.it["resid"],
+                )
+            )
+        self.n += 1
+        for k in self.it:
+            self.it[k] = 0.0
+
+    # -- window reporting --------------------------------------------------
+    def flush(self, now: float) -> None:
+        if self.win_start is None or self.n == 0:
+            return
+        win = now - self.win_start
+        a, n = self.acc, max(self.n, 1)
+
+        def ms(v: float) -> float:
+            return v * 1000.0 / n
+
+        exe = a["exec"] + a["gram"] + a["sample"] + a["wait"]
+        unmarked = win - a["input"] - a["loop_step"]
+        _stage_emit(
+            "win %.1fs n=%d | input %.3fs (%.2fms/it) loop_step "
+            "%.3fs (%.2fms/it) || in step: sched %.3fs (%.2f) exe %.3fs (%.2f) "
+            "upd %.3fs (%.2f) || detail: exec %.3fs (%.2f) gram %.3fs (%.2f) "
+            "sample %.3fs (%.2f) wait %.3fs (%.2f) resid %.3fs (%.2f) "
+            "idle %.3fs (%.2f) unmarked %.3fs"
+            % (
+                win,
+                n,
+                a["input"],
+                ms(a["input"]),
+                a["loop_step"],
+                ms(a["loop_step"]),
+                a["sched"],
+                ms(a["sched"]),
+                exe,
+                ms(exe),
+                a["upd"],
+                ms(a["upd"]),
+                a["exec"],
+                ms(a["exec"]),
+                a["gram"],
+                ms(a["gram"]),
+                a["sample"],
+                ms(a["sample"]),
+                a["wait"],
+                ms(a["wait"]),
+                a["resid"],
+                ms(a["resid"]),
+                a["idle"],
+                ms(a["idle"]),
+                unmarked,
+            )
+        )
+
+        self.win_start = now
+        self.last_flush = now
+        self.n = 0
+        for k in self.acc:
+            self.acc[k] = 0.0
+
+    def maybe_flush(self, now: float) -> None:
+        if self.win_start is None or self.last_flush is None:
+            return
+        if self.n == 0:
+            # Pure-idle window (engine waiting for its first request). Drop it so
+            # startup idle time does not pollute the first real window.
+            if now - self.win_start >= self.window_sec:
+                self.win_start = now
+                self.last_flush = now
+                for k in self.acc:
+                    self.acc[k] = 0.0
+            return
+        if now - self.last_flush >= self.window_sec:
+            self.flush(now)
+
+
